<!DOCTYPE html>
<html>

<head>

    <title>Published Blog Posts</title>

    <style>

        body {
            font-family: Arial;
            background: #f5f5f5;
            padding: 30px;
        }

        .post {
            background: white;
            margin-bottom: 20px;
            padding: 20px;
            border-radius: 10px;
        }

        img {
            max-width: 300px;
        }

    </style>

</head>

<body>

<h1>Published Blog Posts</h1>

<% if (posts.length === 0) { %>

    <p>No published posts found.</p>

<% } %>


<% posts.forEach(post => { %>

    <div class="post">

        <h2>
            <%= post.title %>
        </h2>

        <% if (post.image) { %>

            <img src="<%= post.image %>" alt="Blog Image">

        <% } %>

        <p>
            <%= post.content %>
        </p>

        <p>
            <strong>Tags:</strong>

            <%= post.tags.join(", ") %>
        </p>

        <p>
            <small>
                Author:
                <%= post.author.name %>
            </small>
        </p>

    </div>

<% }) %>

</body>

</html>